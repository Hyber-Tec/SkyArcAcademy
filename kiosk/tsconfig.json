{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@shared/*": ["../shared/src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "../shared/src/kiosk/*.ts", "../shared/src/time.ts"],
  "exclude": ["node_modules", "../shared/src/**/*.test.ts"]
}
