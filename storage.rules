rules_version = '2';

// Nothing in Storage is readable or writable yet: report files and their rules arrive with the HyberCRM fork
// (docs/HYBERCRM_REVIEW.md). Report files concern minors, so every read goes through these rules, never through a
// public download URL.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
