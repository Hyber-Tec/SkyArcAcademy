rules_version = '2';

// Sky Arc Storage rules (forked from HyberCRM). Files are scoped by the academy like its Firestore data, and access
// follows the academy's member documents in Firestore (one role per person). There is no Super Admin and no
// catch-all rule. Report files concern minors: they get their own rules with the progress reports.
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function emailKey() {
      return request.auth.token.email.lower();
    }

    function member(b) {
      return firestore.get(/databases/(default)/documents/branches/$(b)/members/$(emailKey())).data;
    }

    function isMember(b) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/branches/$(b)/members/$(emailKey()))
        && member(b).status == 'active';
    }

    function isAdmin(b) {
      return isMember(b) && member(b).get('role', '') in ['owner', 'admin'];
    }

    match /branches/{b}/announcements/{rest=**} {
      allow read: if isMember(b);
      allow write: if isAdmin(b) && (request.resource == null || request.resource.size < 20 * 1024 * 1024);
    }

    // The Drive's files (shared/src/drive): results and target photos of minors, so staff only, read through these
    // rules (getBlob), never through download links. Staff (coaches too) add files: each file's Firestore record is
    // written first, and the bytes must match it and never replace a file. They're deleted only once the record is in
    // the Trash (admins) or the upload failed (staff).
    function isStaff(b) {
      return isMember(b) && member(b).get('role', '') in ['owner', 'admin', 'coach'];
    }

    match /branches/{b}/drive/{fileId} {
      function record() {
        return firestore.get(/databases/(default)/documents/branches/$(b)/driveFiles/$(fileId)).data;
      }

      allow read: if isStaff(b);
      allow create: if isStaff(b)
        && request.resource.size <= 100 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/(jpeg|png|heic|heif|webp|gif)|text/(plain|csv)|application/(msword|vnd[.]ms-excel|vnd[.]ms-powerpoint|vnd[.]openxmlformats-officedocument[.][a-z.]+)|video/(mp4|quicktime)')
        && record().status == 'uploading'
        && record().size == request.resource.size;
      allow update: if false;
      allow delete: if (isAdmin(b) && record().get('trashed', false) == true)
        || (isStaff(b) && record().status == 'error');
    }
  }
}
