rules_version = '2';

// Sky Arc security rules (forked from HyberCRM).
// - The academy's data lives under branches/{ACADEMY_ID} ('skyarc'; shared/src/academy.ts); access needs an active
//   membership in it. There is no Super Admin.
// - There is no catch-all rule: a collection without a rule is closed.
// - Members are keyed by lower-cased email (branches/{b}/members/{email}); one role per person.
// - Records concern minors: parents read only their own children's records.

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------ identity

    function signedIn() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function emailKey() {
      return request.auth.token.email.lower();
    }

    function branchDoc(b) {
      return get(/databases/$(database)/documents/branches/$(b));
    }

    function memberPath(b) {
      return /databases/$(database)/documents/branches/$(b)/members/$(emailKey());
    }

    function member(b) {
      return get(memberPath(b)).data;
    }

    function isMember(b) {
      return signedIn()
        && exists(memberPath(b))
        && member(b).status == 'active'
        && branchDoc(b).data.status == 'active';
    }

    // One role per person: owner, admin, coach, parent or student.
    function hasRole(b, role) {
      return isMember(b) && member(b).get('role', '') == role;
    }

    function isAdmin(b) {
      return isMember(b) && member(b).get('role', '') in ['owner', 'admin'];
    }

    function isCoach(b) {
      return hasRole(b, 'coach');
    }

    function isStaff(b) {
      return isAdmin(b) || isCoach(b);
    }

    function isOwner(b) {
      return hasRole(b, 'owner');
    }

    function notRestricted(b, page) {
      return !(page in member(b).get('restrictions', []));
    }

    function myStaffId(b) {
      return member(b).get('staffId', null);
    }

    function myStudentId(b) {
      return member(b).get('studentId', null);
    }

    function myStudentIds(b) {
      return member(b).get('studentIds', []);
    }

    // A parent's own children, or the student themself.
    function isFamilyOf(b, studentId) {
      return (hasRole(b, 'parent') && studentId in myStudentIds(b))
        || (hasRole(b, 'student') && studentId == myStudentId(b));
    }

    // -------------------------------------------------------------- helpers

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function stampedNow() {
      return request.resource.data.updatedAt == request.time;
    }

    // ---------------------------------------------------------------- users

    match /users/{uid} {
      allow read: if signedIn() && uid == request.auth.uid;
      allow create, update: if signedIn() && uid == request.auth.uid
        && request.resource.data.email.lower() == emailKey();
      // Deleting an account runs on the server (deleteMyAccount).

      // The phone app's installs and their push tokens (shared/src/push.ts). The server
      // finds a recipient's phones by email; each install removes its own at sign-out.
      match /devices/{deviceId} {
        allow read, delete: if signedIn() && uid == request.auth.uid;
        allow create, update: if signedIn() && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['token', 'email', 'platform', 'appVersion', 'label', 'createdAt', 'updatedAt'])
          && request.resource.data.email == emailKey()
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0
          && request.resource.data.token.size() < 4096
          && request.resource.data.platform in ['ios', 'android'];
      }

      // users/{uid}/private/* (e.g. how many account emails were sent) is server-only:
      // no rule, so no client access.
    }

    // "Which announcements have I read?" — my own read receipts across posts.
    match /{path=**}/reads/{readerKey} {
      allow read: if signedIn() && resource.data.email == emailKey();
    }

    // -------------------------------------------------------------- academy

    // The academy's document is created by the seed script (scripts/seed.ts), never by the app.
    match /branches/{b} {
      allow read: if isMember(b);
      allow create, delete: if false;
      // Admins edit the profile, branding and settings; only owners change the academy rules (pay model, capacity).
      allow update: if isAdmin(b) && stampedNow()
        && (changed().hasOnly(['name', 'shortName', 'timezone', 'locale', 'currency',
                               'branding', 'contact', 'settings', 'updatedAt', 'updatedBy'])
            || (isOwner(b) && changed().hasOnly(['businessRules', 'updatedAt', 'updatedBy'])));

      // Public brand profile for the website, sign-in and sign-up pages, and the website's content (`website`:
      // shared/src/website/types.ts, WebsiteContent), which keeps its shape.
      match /public/{docId} {
        function validWebsiteContent(d) {
          return d.keys().hasOnly(['places', 'team', 'testimonials', 'hours', 'instagram', 'createdAt', 'createdBy',
                                   'updatedAt', 'updatedBy'])
            && d.get('places', {}) is map
            && d.get('team', []) is list && d.get('team', []).size() <= 40
            && d.get('testimonials', []) is list && d.get('testimonials', []).size() <= 100
            && d.get('hours', []) is list && d.get('hours', []).size() <= 12
            && d.get('instagram', '') is string
            && (d.get('instagram', '') == ''
                || d.get('instagram', '').matches('^https://(www[.])?instagram[.]com/[A-Za-z0-9._]{1,30}/?$'));
        }

        allow read: if true;
        allow create, update: if isAdmin(b) && (docId != 'website' || validWebsiteContent(request.resource.data));
        allow delete: if isAdmin(b);
      }

      // ------------------------------------------------------ access

      match /members/{memberId} {
        function grantsAdmin(data) {
          return data.role in ['owner', 'admin'] || data.get('restrictions', []).size() > 0;
        }

        function validMember(data) {
          return data.email == memberId
            && data.role in ['owner', 'admin', 'coach', 'parent', 'student']
            && data.status in ['active', 'disabled'];
        }

        allow read: if isAdmin(b) || (signedIn() && memberId == emailKey());

        // Any admin manages coaches, parents and students; only owners manage admins.
        allow create: if isAdmin(b) && validMember(request.resource.data)
          && (isOwner(b) || !grantsAdmin(request.resource.data));

        allow update: if (isAdmin(b) && validMember(request.resource.data)
            && (isOwner(b) || (!grantsAdmin(resource.data) && !grantsAdmin(request.resource.data))))
          // The person links their own Google account on sign-in.
          || (signedIn() && memberId == emailKey()
            && changed().hasOnly(['uid', 'displayName', 'photoURL', 'firstLoginAt', 'lastLoginAt'])
            && request.resource.data.uid == request.auth.uid);

        // Only owners remove owners and admins, and nobody removes themselves, so an owner always remains.
        allow delete: if isAdmin(b)
          && (isOwner(b) || !grantsAdmin(resource.data))
          && memberId != emailKey();
      }

      match /signupRequests/{email} {
        function signupOpen(role) {
          let profile = get(/databases/$(database)/documents/branches/$(b)/public/profile).data;
          return profile.signupEnabled == true && role in profile.signupRoles;
        }

        allow read: if isAdmin(b) || (signedIn() && email == emailKey());
        allow create: if signedIn() && email == emailKey()
          && request.resource.data.email == email
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == 'pending'
          && signupOpen(request.resource.data.requestedRole);
        allow update: if isAdmin(b)
          || (signedIn() && email == emailKey()
              && resource.data.status == 'pending'
              && request.resource.data.status == 'pending'
              && request.resource.data.uid == request.auth.uid
              && changed().hasOnly(['firstName', 'lastName', 'phone', 'message', 'studentNames',
                                    'requestedRole', 'photoURL', 'updatedAt'])
              && signupOpen(request.resource.data.requestedRole));
        allow delete: if isAdmin(b) || (signedIn() && email == emailKey());
      }

      // ------------------------------------------------------ people

      match /staff/{staffId} {
        allow read: if isAdmin(b) || (isCoach(b) && staffId == myStaffId(b));
        allow create, delete: if isAdmin(b);
        allow update: if isAdmin(b)
          || (isCoach(b) && staffId == myStaffId(b)
              && changed().hasOnly(['phone', 'dob', 'address', 'notificationPrefs', 'updatedAt', 'updatedBy']));

        match /private/{docId} {
          allow read: if (docId == 'compensation'
                          && ((isAdmin(b) && notRestricted(b, 'payRates'))
                              || (isCoach(b) && staffId == myStaffId(b))))
                      || (docId == 'notes' && isAdmin(b));
          allow write: if (docId == 'compensation' && isAdmin(b) && notRestricted(b, 'payRates'))
                       || (docId == 'notes' && isAdmin(b));
        }
      }

      match /students/{studentId} {
        allow read: if isStaff(b)
          || (hasRole(b, 'student') && studentId == myStudentId(b))
          || (hasRole(b, 'parent') && studentId in myStudentIds(b));
        allow create, update, delete: if isAdmin(b);

        // Contacts, parents, address, internal notes: admins only.
        match /private/{docId} {
          allow read, write: if isAdmin(b);
        }
      }

      // ------------------------------------------------------ availability

      // Coaches can't touch days that start inside the lock window (or the lead time,
      // when the branch blocks late availability). Admins can change any day.
      function lockDays() {
        let a = branchDoc(b).data.get('settings', {}).get('availability', {});
        let lock = a.get('lockWindowDays', 7);
        let lead = a.get('leadTimeDays', 14);
        return a.get('leadTimeEnforcement', 'warn') == 'block' && lead > lock ? lead : lock;
      }

      function coachMayEdit(data) {
        return data.dayStartAt is timestamp
          && data.dayStartAt > request.time + duration.value(lockDays(), 'd');
      }

      // A day holds times, or is marked not available (an answer, with no times).
      function validAvailability(docId, data) {
        let utcMidnight = timestamp.date(int(data.dateKey[0:4]), int(data.dateKey[5:7]), int(data.dateKey[8:10]));
        return docId == data.staffId + '_' + data.dateKey
          && data.ranges is list
          && data.get('unavailable', false) is bool
          && (data.get('unavailable', false) == false || data.ranges.size() == 0)
          && data.dayStartAt is timestamp
          && data.dayStartAt > utcMidnight - duration.value(15, 'h')
          && data.dayStartAt < utcMidnight + duration.value(15, 'h');
      }

      // Staff read every coach's days: the coaches in at a class's time teach it together, and see who's in with them.
      match /availability/{docId} {
        allow read: if isStaff(b);
        allow create: if validAvailability(docId, request.resource.data)
          && (isAdmin(b)
              || (isCoach(b) && request.resource.data.staffId == myStaffId(b) && coachMayEdit(request.resource.data)));
        allow update: if validAvailability(docId, request.resource.data)
          && (isAdmin(b)
              || (isCoach(b) && resource.data.staffId == myStaffId(b) && request.resource.data.staffId == myStaffId(b)
                  && coachMayEdit(resource.data) && coachMayEdit(request.resource.data)));
        allow delete: if isAdmin(b) || (isCoach(b) && resource.data.staffId == myStaffId(b) && coachMayEdit(resource.data));
      }

      match /dayConfigs/{dateKey} {
        allow read: if isMember(b);
        allow write: if isAdmin(b);
      }

      // ------------------------------------------------------ schedule

      // Nobody edits a class or a session once its day is over (dayEndAt = next local midnight).
      function dayOpen(data) {
        return data.dayEndAt is timestamp && data.dayEndAt > request.time
          && data.dayEndAt <= data.startAt + duration.value(25, 'h')
          && data.dayEndAt > data.startAt;
      }

      // A class: a time on a day and its seats (shared/src/types.ts, AcademyClass), taught by every coach in at that
      // time. Staff read it (its note is for the coaches) and admins write it; families see their children's sessions,
      // never the class.
      match /classes/{classId} {
        function validClass(d) {
          return d.dateKey is string && d.dateKey.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
            && d.startMin is int && d.endMin is int && d.startMin < d.endMin
            && d.seats is int && d.seats >= 1 && d.seats <= 12
            && d.note is string
            && d.isDeleted is bool;
        }

        allow read: if isStaff(b);
        allow create: if isAdmin(b) && dayOpen(request.resource.data) && validClass(request.resource.data);
        allow update: if isAdmin(b) && dayOpen(resource.data) && dayOpen(request.resource.data)
          && validClass(request.resource.data);
        // Trashed classes can be purged even after their day.
        allow delete: if isAdmin(b) && (dayOpen(resource.data) || resource.data.isDeleted == true);
      }

      // A session is one student's seat in a class. Staff read every one; families read their own children's.
      match /sessions/{sessionId} {
        allow read: if isStaff(b)
          || (hasRole(b, 'student') && resource.data.studentId == myStudentId(b))
          || (hasRole(b, 'parent') && resource.data.studentId in myStudentIds(b));
        allow create: if isAdmin(b) && dayOpen(request.resource.data);
        allow update: if isAdmin(b) && dayOpen(resource.data) && dayOpen(request.resource.data);
        // Trashed sessions can be purged even after their day.
        allow delete: if isAdmin(b) && (dayOpen(resource.data) || resource.data.isDeleted == true);
      }

      match /events/{eventId} {
        allow read: if isStaff(b);
        allow write: if isAdmin(b);
      }

      // ------------------------------------------------------ time & pay

      function lockedThrough() {
        let path = /databases/$(database)/documents/branches/$(b)/payroll/state;
        return exists(path) ? get(path).data.get('lockedThrough', '') : '';
      }

      // Shifts inside a locked pay period can't change.
      function shiftEditable(data) {
        return data.dateKey is string && data.dateKey > lockedThrough();
      }

      match /clockShifts/{shiftId} {
        allow read: if isAdmin(b) || (isCoach(b) && resource.data.staffId == myStaffId(b));
        allow create: if isAdmin(b) && notRestricted(b, 'timeEntries') && shiftEditable(request.resource.data);
        allow update: if isAdmin(b) && notRestricted(b, 'timeEntries')
          && shiftEditable(resource.data) && shiftEditable(request.resource.data);
        allow delete: if isAdmin(b) && notRestricted(b, 'timeEntries') && shiftEditable(resource.data);
      }

      // Pointer to an employee's open shift (written by the kiosk functions).
      match /openShifts/{staffId} {
        allow read: if isAdmin(b) || (isCoach(b) && staffId == myStaffId(b));
        allow delete: if isAdmin(b) && notRestricted(b, 'timeEntries');
      }

      match /payroll/{docId} {
        allow read: if isStaff(b);
        allow write: if isAdmin(b) && notRestricted(b, 'payroll');
      }

      match /payPeriods/{periodId} {
        allow read, write: if isAdmin(b) && notRestricted(b, 'payroll');

        match /lines/{staffId} {
          allow read: if (isAdmin(b) && notRestricted(b, 'payroll')) || (isCoach(b) && staffId == myStaffId(b));
          allow write: if isAdmin(b) && notRestricted(b, 'payroll');
        }
      }

      match /kioskPinOwners/{id} {
        allow read, write: if false;
      }

      // ------------------------------------------------------ communication

      // Coaches see posts for everyone plus posts addressed to them; admins see all.
      // Staff see a post by its audience; parents and students see the posts shown to families, once they're not
      // archived (docs/DECISIONS.md §16). Comments are staff's only.
      function staffSeesAnnouncement(data) {
        return isAdmin(b)
          || (isCoach(b) && (data.audienceType == 'all' || emailKey() in data.audienceKeys));
      }

      // `archived` read directly (no default): a query must ask for unarchived posts to be allowed.
      function familySeesAnnouncement(data) {
        return (hasRole(b, 'parent') || hasRole(b, 'student'))
          && data.get('families', false) == true && data.archived == false;
      }

      function seesAnnouncement(data) {
        return staffSeesAnnouncement(data) || familySeesAnnouncement(data);
      }

      match /announcements/{announcementId} {
        function post() {
          return get(/databases/$(database)/documents/branches/$(b)/announcements/$(announcementId)).data;
        }

        // On the website (shared/src/website/types.ts, AnnouncementWebsite): the address is set once.
        function validWebsite(w) {
          return w == null || (w is map
            && w.keys().hasOnly(['on', 'category', 'cover', 'slug'])
            && w.on is bool
            && w.category in ['results', 'competitions', 'announcements', 'training']
            && (w.cover == null
                || (w.cover is map && w.cover.folder is string
                    && w.cover.folder.matches('^branches/' + b + '/website/posts/' + announcementId + '(/.*)?$')))
            && w.slug is string && w.slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$') && w.slug.size() <= 80);
        }

        // A post for families or the website only may leave the staff audience empty (admins still see it).
        function validPost(data) {
          return data.title is string && data.title.size() > 0 && data.title.size() <= 200
            && data.audienceType in ['all', 'members']
            && data.audienceKeys is list
            && (data.audienceType == 'all' || data.audienceKeys.size() > 0
                || data.get('families', false) == true || data.get('website', {}).get('on', false) == true)
            && data.get('families', false) is bool
            && validWebsite(data.get('website', null));
        }

        allow read: if seesAnnouncement(resource.data);
        // Read and comment counters are kept by Cloud Functions.
        allow create: if isAdmin(b) && validPost(request.resource.data)
          && request.resource.data.authorKey == emailKey()
          && request.resource.data.readCount == 0
          && request.resource.data.commentCount == 0;
        allow update: if isAdmin(b) && validPost(request.resource.data)
          && !changed().hasAny(['readCount', 'commentCount', 'authorKey']);
        allow delete: if isAdmin(b);

        // Read receipts: written once by the reader, never changed.
        match /reads/{readerKey} {
          allow read: if isAdmin(b) || (signedIn() && readerKey == emailKey());
          allow create: if signedIn() && readerKey == emailKey()
            && request.resource.data.email == emailKey()
            && request.resource.data.branchId == b
            && request.resource.data.announcementId == announcementId
            && request.resource.data.readAt == request.time
            && seesAnnouncement(post());
          allow update, delete: if false;
        }

        match /comments/{commentId} {
          allow read: if staffSeesAnnouncement(post());
          allow create: if staffSeesAnnouncement(post())
            && (isAdmin(b) || post().commentsEnabled == true)
            && request.resource.data.authorKey == emailKey()
            && request.resource.data.createdAt == request.time
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 2000;
          allow update: if false;
          allow delete: if isAdmin(b) || (signedIn() && resource.data.authorKey == emailKey());
        }
      }

      // In-app inbox. Items are written by Cloud Functions; people read,
      // mark read and delete their own.
      match /notifications/{notificationId} {
        allow read: if isMember(b) && resource.data.recipientKey == emailKey();
        allow update: if isMember(b) && resource.data.recipientKey == emailKey()
          && changed().hasOnly(['readAt']);
        allow delete: if isMember(b) && resource.data.recipientKey == emailKey();
        allow create: if false;
      }

      // ------------------------------------------------------ drive

      // The Drive (shared/src/drive/types.ts): one folder per student at the top, plus any folders staff make.
      // Staff (admins and coaches alike: coaches scan cards and add results too, the owner's call of 2026-10-17) open
      // it, add, rename, move and trash. Only admins empty the Trash; anyone on staff clears a failed upload. Families
      // never browse it: they read only a score's file in their own child's folder (a SIUS result's PDF, a paper card's
      // picture), out of the Trash, as storage.rules lets them read its bytes. A file stops being a score's file
      // (`evaluationId` cleared) when the score is deleted or the file moves to another student.
      function byMe(actor) {
        return actor is map && actor.email == emailKey();
      }

      function validFolder(folderId, d) {
        return d.keys().hasOnly(['name', 'parentId', 'studentId', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy',
                                 'trashed', 'trashedAt', 'trashedBy'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 120
          && (d.parentId == null || (d.parentId is string && d.parentId != folderId))
          // A student's folder is named after the student, sits at the top and can't be trashed.
          && (d.studentId == null
              || (d.studentId is string && folderId == 'student-' + d.studentId && d.parentId == null
                  && d.get('trashed', false) == false));
      }

      match /driveFolders/{folderId} {
        allow read: if isStaff(b);
        allow create: if isStaff(b) && validFolder(folderId, request.resource.data)
          && request.resource.data.get('trashed', false) == false
          && byMe(request.resource.data.createdBy);
        allow update: if isStaff(b) && validFolder(folderId, request.resource.data)
          && request.resource.data.studentId == resource.data.studentId
          && request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if isAdmin(b) && resource.data.get('trashed', false) == true;
      }

      function validFile(d) {
        return d.keys().hasOnly(['name', 'size', 'kind', 'mime', 'status', 'error', 'folderId', 'studentId', 'evaluationId',
                                 'originalName', 'uploadedAt', 'uploadedBy', 'updatedAt', 'updatedBy', 'trashed', 'trashedAt',
                                 'trashedBy'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 200
          && d.size is int && d.size > 0 && d.size <= 100 * 1024 * 1024
          && d.kind is string && d.mime is string
          && d.status in ['uploading', 'ready', 'error']
          && (d.folderId == null || d.folderId is string)
          && (d.studentId == null || d.studentId is string);
      }

      match /driveFiles/{fileId} {
        function familyResult(d) {
          return d.get('evaluationId', null) is string && d.get('trashed', false) == false && d.status == 'ready'
            && d.get('studentId', null) is string && isFamilyOf(b, d.studentId);
        }

        // A family opens one record by its ID (never a list: a query could leave the Trash check unasked).
        allow get: if isStaff(b) || familyResult(resource.data);
        allow list: if isStaff(b);
        // The record comes first (status uploading), then the bytes (storage.rules checks the record).
        allow create: if isStaff(b) && validFile(request.resource.data)
          && request.resource.data.status == 'uploading'
          && request.resource.data.get('trashed', false) == false
          && byMe(request.resource.data.uploadedBy);
        allow update: if isStaff(b) && validFile(request.resource.data)
          && request.resource.data.size == resource.data.size
          && request.resource.data.kind == resource.data.kind
          && request.resource.data.mime == resource.data.mime
          && request.resource.data.uploadedBy == resource.data.uploadedBy;
        allow delete: if (isAdmin(b) && resource.data.get('trashed', false) == true)
          || (isStaff(b) && resource.data.status == 'error');
      }

      // ------------------------------------------------------ scores and reports

      // Evaluations: one scored target each (a SIUS result or a paper card). Staff (admins and coaches) read, add,
      // correct and delete them, each change in the audit log. Families read their own children's (the owner,
      // 2026-10-17: every score, not only the reports), one student at a time.
      match /evaluations/{evaluationId} {
        function validEvaluation(d) {
          return d.studentId is string && d.studentName is string
            && d.source in ['sius', 'paper']
            && d.position in ['standing', 'kneeling', 'prone']
            && d.dateKey is string && d.dateKey.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
            && d.shots is int && d.shots >= 0 && d.shots <= 200
            && d.total is number && d.wholeTotal is number
            && d.series is list && d.series.size() <= 20
            && d.note is string && d.note.size() <= 2000;
        }

        allow read: if isStaff(b) || isFamilyOf(b, resource.data.studentId);
        allow create, update: if isStaff(b) && validEvaluation(request.resource.data);
        allow delete: if isStaff(b);
      }

      // Progress reports: admins make and edit drafts; admins and coaches share them (docs/DECISIONS.md §6, Q11:
      // coaches read every report and may share one, never change or delete it); families read their own children's
      // shared reports. Who was told, and the first view, are written by Cloud Functions.
      match /progressReports/{reportId} {
        function shared() {
          return resource.data.sharedWithParents == true;
        }

        function sharingOnly() {
          return changed().hasOnly(['status', 'sharedWithParents', 'sharedAt', 'sharedBy', 'updatedAt', 'updatedBy']);
        }

        allow read: if isStaff(b)
          || (hasRole(b, 'parent') && resource.data.studentId in myStudentIds(b) && shared())
          || (hasRole(b, 'student') && resource.data.studentId == myStudentId(b) && shared());
        allow create: if isAdmin(b)
          && request.resource.data.schemaVersion == 1
          && request.resource.data.status == 'draft'
          && request.resource.data.sharedWithParents == false
          && request.resource.data.studentId is string
          && byMe(request.resource.data.generatedBy)
          && request.resource.data.notify == null
          && request.resource.data.firstViewedAt == null;
        allow update: if (
            // A draft: admins edit anything but whose report it is and what the server writes.
            isAdmin(b) && resource.data.status == 'draft'
            && request.resource.data.status == 'draft' && request.resource.data.sharedWithParents == false
            && request.resource.data.studentId == resource.data.studentId
            && !changed().hasAny(['schemaVersion', 'notify', 'firstViewedAt', 'generatedAt', 'generatedBy'])
            && stampedNow()
          ) || (
            // Sharing a draft with the family: admins and coaches.
            isStaff(b) && sharingOnly() && resource.data.status == 'draft'
            && request.resource.data.status == 'shared' && request.resource.data.sharedWithParents == true
            && request.resource.data.sharedAt == request.time && byMe(request.resource.data.sharedBy)
          ) || (
            // Stopping sharing (back to a draft): admins.
            isAdmin(b) && sharingOnly() && resource.data.status == 'shared'
            && request.resource.data.status == 'draft' && request.resource.data.sharedWithParents == false
          ) || (
            isAdmin(b) && changed().hasOnly(['customName', 'updatedAt', 'updatedBy'])
          );
        allow delete: if isAdmin(b);

        // A family member's first opening of a shared report (written once).
        match /views/{viewerKey} {
          function report() {
            return get(/databases/$(database)/documents/branches/$(b)/progressReports/$(reportId)).data;
          }

          allow read: if isStaff(b);
          allow create: if viewerKey == emailKey()
            && request.resource.data.viewedAt == request.time
            && report().sharedWithParents == true
            && ((hasRole(b, 'parent') && report().studentId in myStudentIds(b))
              || (hasRole(b, 'student') && report().studentId == myStudentId(b)));
          allow update, delete: if false;
        }
      }

      // ------------------------------------------------------ website

      // The public website (shared/src/website): anyone reads its photos (unless hidden) and the news copied from
      // announcements. Admins manage the photos on the CRM's Website page; the website's other content (places, team,
      // testimonials, hours) is public/website, under the public rule above. Messages sent from the website are
      // written by the websiteMessage function only: admins read them, mark them done and delete them.
      match /websitePhotos/{photoId} {
        function validPhoto(d) {
          return d.keys().hasOnly(['album', 'caption', 'alt', 'focus', 'order', 'hidden', 'folder', 'format', 'widths',
                                   'width', 'height', 'color', 'blur', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
            && d.album in ['training', 'coaching', 'competition', 'community', 'pages']
            && d.caption is string && d.caption.size() <= 200
            && d.alt is string && d.alt.size() <= 400
            && d.focus is string && d.focus.size() <= 24
            && d.order is number
            && d.hidden is bool
            && d.folder == 'branches/' + b + '/website/photos/' + photoId
            && d.format in ['webp', 'jpeg']
            && d.widths is list && d.widths.size() > 0 && d.widths.size() <= 4
            && d.width is number && d.height is number
            && d.color is string && d.color.size() <= 40
            && d.blur is string && d.blur.size() <= 4000;
        }

        allow read: if resource.data.hidden == false || isAdmin(b);
        allow create, update: if isAdmin(b) && validPhoto(request.resource.data);
        allow delete: if isAdmin(b);
      }

      match /websitePosts/{postId} {
        allow read: if true;
        allow write: if false;
      }

      match /websiteMessages/{messageId} {
        allow read, delete: if isAdmin(b);
        allow update: if isAdmin(b)
          && changed().hasOnly(['status', 'doneAt', 'doneBy'])
          && request.resource.data.status in ['new', 'done'];
        allow create: if false;
      }

      // ------------------------------------------------------ audit log

      match /auditLog/{entryId} {
        allow read: if isAdmin(b);
        allow create: if isStaff(b)
          && request.resource.data.actorEmail == emailKey()
          && request.resource.data.at == request.time;
        allow update, delete: if false;
      }

      // Server-only collections.
      match /kioskPins/{id} {
        allow read, write: if false;
      }

      match /websiteLimits/{key} {
        allow read, write: if false;
      }
    }
  }
}
